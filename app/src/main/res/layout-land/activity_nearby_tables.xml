<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lobby_activity"
    android:padding="@dimen/screen_padding_compact">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/Widget.GiocoDel15.OutlineButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/nearby_cancel"
        app:layout_constraintEnd_toEndOf="@id/nearbyHeader"
        app:layout_constraintStart_toStartOf="@id/nearbyHeader"
        app:layout_constraintTop_toBottomOf="@id/nearbyHeader" />

    <LinearLayout
        android:id="@+id/nearbyHeader"
        android:layout_width="@dimen/land_header_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/nearbyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/russo_one"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/nearby_title"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/screen_title"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/nearbySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFamily="@font/rajdhani_semibold"
            android:gravity="center"
            android:textAlignment="center"
            android:letterSpacing="@dimen/uppercase_letter_spacing"
            android:text="@string/nearby_subtitle"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/text_caption"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/nearbyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:fontFamily="@font/rajdhani_medium"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/nearby_searching"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/text_body_secondary"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/nearbyErrorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_card_error"
            android:padding="@dimen/space_12"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/nearbyErrorIconContainer"
                android:layout_width="@dimen/icon_32"
                android:layout_height="@dimen/icon_32"
                android:background="@drawable/bg_icon_circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/icon_20"
                    android:layout_height="@dimen/icon_20"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wifi_off"
                    android:contentDescription="@null"
                    app:tint="@color/game_red" />
            </FrameLayout>

            <TextView
                android:id="@+id/nearbyErrorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:fontFamily="@font/rajdhani_bold"
                android:text="@string/nearby_wifi_required_title"
                android:textColor="@color/game_text_primary"
                android:textSize="@dimen/text_body_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/nearbyErrorIconContainer"
                app:layout_constraintTop_toTopOf="@id/nearbyErrorIconContainer" />

            <TextView
                android:id="@+id/nearbyErrorBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/nearby_wifi_required_body"
                android:textColor="@color/game_text_secondary"
                android:textSize="@dimen/text_caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/nearbyErrorTitle"
                app:layout_constraintTop_toBottomOf="@id/nearbyErrorTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nearbyErrorRetryButton"
                style="@style/Widget.GiocoDel15.OutlineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:minHeight="0dp"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4"
                android:text="@string/nearby_enable"
                android:textSize="@dimen/text_caption"
                app:strokeColor="@color/game_red"
                android:textColor="@color/game_red"
                app:layout_constraintStart_toStartOf="@id/nearbyErrorTitle"
                app:layout_constraintTop_toBottomOf="@id/nearbyErrorBody" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nearbyHeader"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/tablesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.lucapiciollo.giocodel15.core.ui.NearbyRadarView
        android:id="@+id/rippleWave"
        android:layout_width="@dimen/radar_size"
        android:layout_height="@dimen/radar_size"
        android:contentDescription="@string/cd_radar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nearbyHeader"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
