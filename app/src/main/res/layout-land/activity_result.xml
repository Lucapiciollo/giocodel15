<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_activity"
    android:padding="@dimen/space_lg">

    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.58">

        <ImageView
            android:id="@+id/winnerTrophy"
            android:layout_width="@dimen/icon_40"
            android:layout_height="@dimen/icon_40"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_emoji_events"
            android:contentDescription="@string/cd_trophy"
            app:tint="@color/game_gold" />

        <TextView
            android:id="@+id/winnerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="@font/russo_one"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/screen_title"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/winnerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="@font/rajdhani_bold"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/game_green"
            android:textSize="@dimen/section_title"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:fontFamily="@font/rajdhani_bold"
            android:text="@string/result_round_ranking"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/body_size" />

        <ScrollView
            android:id="@+id/rankingScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:id="@+id/rankingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_xl"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_bold"
            android:text="@string/result_table_ranking"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/body_size" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:id="@+id/tableRankingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tableStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/body_size" />

        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newRoundButton"
                style="@style/Widget.GiocoDel15.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_new_round"
                app:backgroundTint="@color/game_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newTableButton"
                style="@style/Widget.GiocoDel15.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/result_new_table"
                app:backgroundTint="@color/game_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.GiocoDel15.OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/result_close" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
