<?xml version="1.0" encoding="utf-8"?>
<!--
    Global app background — landscape variant.
    Blobs repositioned wider/flatter for the wide aspect ratio.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/game_bg_primary" />
        </shape>
    </item>
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="top|start"
        android:left="-140dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerColor="#3300E676"
                android:endColor="@color/game_transparent" />
        </shape>
    </item>
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="bottom|end"
        android:right="-160dp"
        android:bottom="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerColor="#2E00BFFF"
                android:endColor="@color/game_transparent" />
        </shape>
    </item>
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="center_vertical|end"
        android:right="60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerColor="#1FFFC107"
                android:endColor="@color/game_transparent" />
        </shape>
    </item>
</layer-list>
