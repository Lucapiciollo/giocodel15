<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GiocoDel15" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:colorAccent">@color/game_secondary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorSecondary">@color/game_secondary</item>
    </style>

    <style name="Theme.GiocoDel15.Splash">
        <item name="android:windowBackground">@drawable/bg_aurora</item>
    </style>

    <style name="Widget.GiocoDel15.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">@dimen/button_elevation</item>
        <item name="android:outlineAmbientShadowColor">@color/game_primary</item>
        <item name="android:outlineSpotShadowColor">@color/game_primary</item>
    </style>

    <style name="Widget.GiocoDel15.SecondaryButton" parent="Widget.GiocoDel15.PrimaryButton">
        <item name="backgroundTint">@color/game_secondary</item>
        <item name="android:outlineAmbientShadowColor">@color/game_secondary</item>
        <item name="android:outlineSpotShadowColor">@color/game_secondary</item>
    </style>

    <style name="Widget.GiocoDel15.OutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/game_primary</item>
        <item name="strokeWidth">@dimen/outline_stroke_width</item>
        <item name="android:textColor">@color/game_primary</item>
        <item name="android:elevation">@dimen/button_outline_elevation</item>
        <item name="android:outlineAmbientShadowColor">@color/game_primary</item>
        <item name="android:outlineSpotShadowColor">@color/game_primary</item>
    </style>

    <!-- Segment control option — used inside MaterialButtonToggleGroup as a drop-in
         replacement look for stock outlined toggle buttons. Kept as a MaterialButton
         (Checkable) so existing checkedButtonId/.check()/addOnButtonCheckedListener
         Kotlin logic keeps working untouched; only the visual chrome changes to match
         the Premium Gamer segment control (bg_segment / bg_segment_selected). -->
    <style name="Widget.GiocoDel15.SegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/segment_height</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
        <item name="strokeColor">@color/segment_stroke_selector</item>
        <item name="strokeWidth">@dimen/card_stroke_width_thin</item>
        <item name="backgroundTint">@color/segment_fill_selector</item>
        <item name="android:textColor">@color/segment_text_selector</item>
        <item name="rippleColor">@color/game_green</item>
    </style>

    <!-- ============================================================
         Text appearances — Premium Gamer typography scale.
         Titles/logo: Russo One (display, arcade/esports wordmark look).
         Subtitles/labels/HUD/buttons: Rajdhani (technical, gaming feel).
         Body/caption: Rajdhani Regular/Medium for readability.
         Titles/subtitles carry a drop shadow for contrast over photo
         backgrounds (bg_*_activity.png).
         ============================================================ -->
    <style name="TextAppearance.GiocoDel15.HomeLogo" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/russo_one</item>
        <item name="android:textSize">@dimen/home_logo_text</item>
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="TextAppearance.GiocoDel15.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/russo_one</item>
        <item name="android:textSize">@dimen/screen_title</item>
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="TextAppearance.GiocoDel15.ScreenSubtitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">@dimen/screen_subtitle</item>
        <item name="android:textColor">@color/game_text_secondary</item>
        <item name="android:letterSpacing">@dimen/uppercase_letter_spacing</item>
        <item name="android:shadowColor">#E6000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="TextAppearance.GiocoDel15.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textSize">@dimen/section_title</item>
        <item name="android:textColor">@color/game_text_primary</item>
    </style>

    <style name="TextAppearance.GiocoDel15.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/game_text_primary</item>
    </style>

    <style name="TextAppearance.GiocoDel15.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
        <item name="android:textColor">@color/game_text_secondary</item>
    </style>

    <style name="TextAppearance.GiocoDel15.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/rajdhani_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/game_text_muted</item>
    </style>

    <style name="TextAppearance.GiocoDel15.ButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textSize">@dimen/button_text</item>
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.GiocoDel15.HudLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">@dimen/hud_label</item>
        <item name="android:textColor">@color/game_text_secondary</item>
        <item name="android:letterSpacing">@dimen/uppercase_letter_spacing</item>
    </style>

    <style name="TextAppearance.GiocoDel15.HudValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textSize">@dimen/hud_value</item>
        <item name="android:textColor">@color/game_text_primary</item>
    </style>

    <style name="TextAppearance.GiocoDel15.TimerValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textSize">@dimen/timer_value</item>
        <item name="android:textColor">@color/game_green</item>
    </style>

    <!-- ============================================================
         Switch (Settings) — green track when ON, no default Material tint.
         ============================================================ -->
    <style name="Widget.GiocoDel15.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbTint">@color/switch_thumb_selector</item>
    </style>
</resources>
