<?xml version="1.0" encoding="utf-8"?>
<!--
    Puzzle number tile — gold gradient with soft drop shadow.
    Bottom layer is an offset shadow shape; top layer is the actual
    gradient tile with its highlight stroke.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/tile_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/game_tile_shadow" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item android:bottom="@dimen/tile_shadow_offset">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/game_tile_top"
                android:endColor="@color/game_tile_bottom" />
            <corners android:radius="@dimen/radius_medium" />
            <stroke
                android:width="@dimen/tile_stroke_width"
                android:color="@color/game_tile_stroke" />
        </shape>
    </item>
</layer-list>
