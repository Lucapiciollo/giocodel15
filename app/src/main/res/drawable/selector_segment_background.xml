<?xml version="1.0" encoding="utf-8"?>
<!-- Selector combining bg_segment / bg_segment_selected based on the checked/selected state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/bg_segment_selected" />
    <item android:state_selected="true" android:drawable="@drawable/bg_segment_selected" />
    <item android:drawable="@drawable/bg_segment" />
</selector>
