<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/game_background" />
        </shape>
    </item>
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|start"
        android:left="-60dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerColor="@color/aurora_green"
                android:endColor="@color/aurora_green_end" />
        </shape>
    </item>
    <item
        android:width="280dp"
        android:height="280dp"
        android:gravity="top|end"
        android:right="-80dp"
        android:top="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerColor="@color/aurora_blue"
                android:endColor="@color/aurora_blue_end" />
        </shape>
    </item>
</layer-list>
