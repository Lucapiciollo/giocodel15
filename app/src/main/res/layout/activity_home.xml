<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_game_global"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_28"
        android:paddingBottom="@dimen/space_32">

        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
            <ImageButton android:id="@+id/settingsButton" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="end" android:background="@drawable/bg_icon_circle" android:contentDescription="@string/settings" android:padding="14dp" android:src="@drawable/ic_settings" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="@dimen/space_12">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="@string/app_name" android:textColor="@color/game_text_primary" android:textSize="@dimen/home_logo_text" android:textStyle="bold" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:orientation="horizontal">
                <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_tile_logo" android:fontFamily="sans-serif" android:gravity="center" android:text="1" android:textColor="@color/game_tile_text" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="@dimen/space_8" android:background="@drawable/bg_tile_logo" android:fontFamily="sans-serif" android:gravity="center" android:text="5" android:textColor="@color/game_tile_text" android:textSize="30sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tagline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:fontFamily="sans-serif" android:letterSpacing="0.15" android:text="@string/home_tagline" android:textColor="@color/game_text_secondary" android:textSize="@dimen/screen_subtitle" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/createTableButton" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="@dimen/space_32" android:background="@drawable/bg_card_green" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_icon_green"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_add" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="@string/create_table" android:textColor="@color/game_text_primary" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/create_table_helper" android:textColor="@color/game_text_secondary" android:textSize="@dimen/body_secondary" /></LinearLayout>
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chevron_right" android:tint="@color/game_green" />
        </LinearLayout>

        <LinearLayout android:id="@+id/joinTableButton" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="@dimen/space_16" android:background="@drawable/bg_card_blue" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_icon_blue"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_groups" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="@string/join_table" android:textColor="@color/game_text_primary" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/join_table_helper" android:textColor="@color/game_text_secondary" android:textSize="@dimen/body_secondary" /></LinearLayout>
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chevron_right" android:tint="@color/game_cyan" />
        </LinearLayout>

        <LinearLayout android:id="@+id/soloGameButton" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="@dimen/space_16" android:background="@drawable/bg_card_gold" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_icon_gold"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_person" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="@string/solo_game" android:textColor="@color/game_text_primary" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/solo_game_helper" android:textColor="@color/game_text_secondary" android:textSize="@dimen/body_secondary" /></LinearLayout>
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chevron_right" android:tint="@color/game_gold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
