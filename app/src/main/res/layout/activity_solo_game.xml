<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:padding="@dimen/space_md">

    <!-- ============== HUD: 3 stat cards (Griglia / Tempo / Mosse) ============== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gridStatCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_blue"
        android:padding="@dimen/space_12"
        app:layout_constraintEnd_toStartOf="@id/timerStatCard"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/gridStatIcon"
            android:layout_width="@dimen/icon_20"
            android:layout_height="@dimen/icon_20"
            android:src="@drawable/ic_grid_view"
            android:contentDescription="@null"
            app:tint="@color/game_cyan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/gridLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:letterSpacing="@dimen/uppercase_letter_spacing"
            android:text="@string/game_grid_label"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/hud_label"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridStatIcon" />

        <TextView
            android:id="@+id/gridValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/hud_value"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timerStatCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:background="@drawable/bg_card_green"
        android:padding="@dimen/space_12"
        app:layout_constraintEnd_toStartOf="@id/movesStatCard"
        app:layout_constraintHorizontal_weight="1.3"
        app:layout_constraintStart_toEndOf="@id/gridStatCard"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/timerStatIcon"
            android:layout_width="@dimen/icon_20"
            android:layout_height="@dimen/icon_20"
            android:src="@drawable/ic_timer"
            android:contentDescription="@null"
            app:tint="@color/game_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/timerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:letterSpacing="@dimen/uppercase_letter_spacing"
            android:text="@string/game_timer_label"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/hud_label"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timerStatIcon" />

        <TextView
            android:id="@+id/timerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00.000"
            android:textColor="@color/game_green"
            android:textSize="@dimen/timer_value_compact"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timerLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/movesStatCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_blue"
        android:padding="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.85"
        app:layout_constraintStart_toEndOf="@id/timerStatCard"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/movesStatIcon"
            android:layout_width="@dimen/icon_20"
            android:layout_height="@dimen/icon_20"
            android:src="@drawable/ic_touch_app"
            android:contentDescription="@null"
            app:tint="@color/game_cyan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/movesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:letterSpacing="@dimen/uppercase_letter_spacing"
            android:text="@string/game_moves_label"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/hud_label"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movesStatIcon" />

        <TextView
            android:id="@+id/movesValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/hud_value"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movesLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/hudBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="gridStatCard,timerStatCard,movesStatCard" />

    <com.lucapiciollo.giocodel15.core.ui.PuzzleBoardView
        android:id="@+id/puzzleBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_24"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hudBottomBarrier"
        app:layout_constraintWidth_max="@dimen/board_max_size" />

    <TextView
        android:id="@+id/gameStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:textColor="@color/game_text_primary"
        android:textSize="@dimen/body_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/puzzleBoard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/replayButton"
        style="@style/Widget.GiocoDel15.PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/solo_replay"
        android:textColor="@color/game_text_primary"
        android:visibility="gone"
        app:backgroundTint="@color/game_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gameStatus" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/goHomeButton"
        style="@style/Widget.GiocoDel15.OutlineButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/solo_go_home"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/replayButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
