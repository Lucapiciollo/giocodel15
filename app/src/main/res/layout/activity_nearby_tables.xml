<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_game_global" android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding" android:paddingTop="@dimen/space_20" android:paddingBottom="@dimen/space_16">

    <ImageButton android:id="@+id/backButton" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@string/back_home" android:padding="14dp" android:src="@drawable/ic_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/nearbyTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:fontFamily="sans-serif-condensed" android:text="@string/nearby_title" android:textColor="@color/game_text_primary" android:textSize="30sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/backButton" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/backButton" />
    <TextView android:id="@+id/nearbySubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:layout_marginTop="2dp" android:letterSpacing="0.15" android:text="@string/nearby_subtitle" android:textColor="@color/game_text_secondary" android:textSize="@dimen/screen_subtitle" app:layout_constraintStart_toEndOf="@id/backButton" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/nearbyTitle" />

    <com.lucapiciollo.giocodel15.core.ui.NearbyRadarView android:id="@+id/radarView" android:layout_width="230dp" android:layout_height="230dp" android:layout_marginTop="@dimen/space_16" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/backButton" />

    <TextView android:id="@+id/nearbyStatus" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_card_neutral" android:fontFamily="sans-serif" android:gravity="center_vertical" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:text="@string/nearby_searching" android:textColor="@color/game_text_secondary" android:textSize="15sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/radarView" />

    <LinearLayout android:id="@+id/permissionCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_card_error" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/space_16" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/nearbyStatus">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="@string/nearby_permission_title" android:textColor="@color/game_text_primary" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nearby_permission_denied" android:textColor="@color/game_text_secondary" android:textSize="13sp"/></LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/permissionAction" style="@style/Widget.GiocoDel15.PrimaryButton" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginStart="@dimen/space_12" android:text="@string/nearby_permission_action" android:textSize="14sp" app:backgroundTint="@color/game_red_dark" />
    </LinearLayout>

    <ScrollView android:id="@+id/tablesScroll" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="@dimen/space_12" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="@dimen/space_16" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/permissionCard" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:id="@+id/tablesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
