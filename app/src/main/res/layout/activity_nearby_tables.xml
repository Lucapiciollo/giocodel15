<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nearby_tables_activity"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/nearbyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/nearby_title"
        android:textAppearance="@style/TextAppearance.GiocoDel15.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nearbySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/nearby_subtitle"
        android:textAppearance="@style/TextAppearance.GiocoDel15.ScreenSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyTitle" />

    <TextView
        android:id="@+id/nearbyStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/nearby_searching"
        android:textAppearance="@style/TextAppearance.GiocoDel15.BodySecondary"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbySubtitle" />

    <!-- Friendly permission/error card — replaces raw technical error toasts. Hidden by default. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nearbyErrorCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_card_error"
        android:padding="@dimen/space_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyStatus"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/nearbyErrorIconContainer"
            android:layout_width="@dimen/icon_40"
            android:layout_height="@dimen/icon_40"
            android:background="@drawable/bg_icon_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/icon_20"
                android:layout_height="@dimen/icon_20"
                android:layout_gravity="center"
                android:src="@drawable/ic_wifi_off"
                android:contentDescription="@null"
                app:tint="@color/game_red" />
        </FrameLayout>

        <TextView
            android:id="@+id/nearbyErrorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:fontFamily="@font/rajdhani_bold"
            android:text="@string/nearby_wifi_required_title"
            android:textColor="@color/game_text_primary"
            android:textSize="@dimen/text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/nearbyErrorIconContainer"
            app:layout_constraintTop_toTopOf="@id/nearbyErrorIconContainer" />

        <TextView
            android:id="@+id/nearbyErrorBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/nearby_wifi_required_body"
            android:textColor="@color/game_text_secondary"
            android:textSize="@dimen/text_body_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/nearbyErrorTitle"
            app:layout_constraintTop_toBottomOf="@id/nearbyErrorTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nearbyErrorRetryButton"
            style="@style/Widget.GiocoDel15.OutlineButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:minHeight="0dp"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/nearby_enable"
            android:textSize="@dimen/text_caption"
            app:strokeColor="@color/game_red"
            android:textColor="@color/game_red"
            app:layout_constraintStart_toStartOf="@id/nearbyErrorTitle"
            app:layout_constraintTop_toBottomOf="@id/nearbyErrorBody" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/cancelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyErrorCard">

        <LinearLayout
            android:id="@+id/tablesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.lucapiciollo.giocodel15.core.ui.NearbyRadarView
        android:id="@+id/rippleWave"
        android:layout_width="@dimen/radar_size"
        android:layout_height="@dimen/radar_size"
        android:contentDescription="@string/cd_radar"
        app:layout_constraintBottom_toTopOf="@id/cancelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyErrorCard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/Widget.GiocoDel15.OutlineButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nearby_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
