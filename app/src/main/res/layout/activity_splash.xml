<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora">

    <LinearLayout
        android:id="@+id/tileGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/appTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="1" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="2" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="3" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="4" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="5" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="6" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="7" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="8" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="9" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="10" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
            <TextView android:tag="blank" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" />
            <TextView android:tag="tile" android:layout_width="@dimen/splash_tile_size" android:layout_height="@dimen/splash_tile_size" android:layout_margin="@dimen/splash_tile_gap" android:background="@drawable/splash_tile_bg" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:text="11" android:textColor="@color/game_tile_text" android:textSize="@dimen/splash_tile_text_size" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:alpha="0"
        android:fontFamily="@font/russo_one"
        android:text="@string/app_name"
        android:textColor="@color/game_text_primary"
        android:textSize="@dimen/title_size"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        app:layout_constraintBottom_toTopOf="@id/appTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tileGrid" />

    <TextView
        android:id="@+id/appTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_xl"
        android:alpha="0"
        android:fontFamily="@font/rajdhani_semibold"
        android:letterSpacing="0.08"
        android:text="@string/home_tagline"
        android:textColor="@color/game_text_secondary"
        android:textSize="@dimen/caption_size"
        android:shadowColor="#E6000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
